{
  "name": "neodex-ui",
  "productName": "neoDEX-UI",
  "version": "3.0.0-pre",
  "description": "A science fiction desktop running everywhere. Awesome.",
  "keywords": [
    "desktop",
    "sci-fi",
    "gui",
    "portable",
    "tty",
    "terminal"
  ],
  "main": "src/_boot.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "package": "node scripts/prepare-package.js && electron-builder --publish never",
    "package:dir": "node scripts/prepare-package.js && electron-builder --dir --publish never",
    "prestart": "npm run build:renderer",
    "start": "electron src --nointro",
    "test": "npm run test:unit && npm run test:e2e",
    "init-file-icons": "git submodule update --init",
    "update-file-icons": "git submodule foreach git pull origin master && node file-icons-generator.js",
    "postinstall": "node scripts/postinstall.js",
    "pretest:e2e": "npm run build:renderer",
    "test:e2e": "playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamsjoe/neodex-ui.git"
  },
  "author": "Joseph Adams (https://github.com/adamsjoe)",
  "contributors": [
    "Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev) (original eDEX-UI author)"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/adamsjoe/neodex-ui/issues"
  },
  "homepage": "https://github.com/adamsjoe/neodex-ui#readme",
  "build": {
    "appId": "io.github.adamsjoe.neodex-ui",
    "productName": "neoDEX-UI",
    "publish": "github",
    "asar": true,
    "compression": "normal",
    "copyright": "Copyright © 2017-2021 Gabriel 'Squared' SAILLARD, © 2026 Joseph Adams",
    "directories": {
      "output": "dist",
      "app": "prebuild-src"
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "artifactName": "neoDEX-UI-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "System",
      "icon": "media/linuxIcons"
    },
    "appImage": {
      "artifactName": "neoDEX-UI-Linux-${arch}.AppImage"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "media/icon.icns"
    },
    "dmg": {
      "artifactName": "neoDEX-UI-macOS-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "media/icon.ico"
    },
    "nsis": {
      "artifactName": "neoDEX-UI-Windows-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "cson-parser": "4.0.9"
  }
}
